# Copy to .env.local for local development. Every variable has a default, so an empty file
# also works; the values below are the ones the defaults already use, spelled out so that the
# set of knobs is discoverable.
#
# In AWS these come from the ECS task definition, and DYNAMODB_ENDPOINT is left unset: its
# absence is what tells the server it is not allowed to create tables.

PORT=3001
LOG_LEVEL=info

AWS_REGION=ap-northeast-1

# DynamoDB Local, started by `npm run db:up`.
DYNAMODB_ENDPOINT=http://localhost:8000
TOURNAMENTS_TABLE=quiz-world-tournaments
ROOM_SNAPSHOTS_TABLE=quiz-world-room-snapshots

# Origin the SPA is served from, used to build invite URLs. In development this is the Vite
# dev server, which proxies /api and /socket.io back to PORT above.
PUBLIC_BASE_URL=http://localhost:5173
